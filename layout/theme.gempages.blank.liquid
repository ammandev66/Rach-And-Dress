<!doctype html>
<html class="no-js" lang="{{ shop.locale }}">
<head>
  <!-- Global site tag (gtag.js) - Google Ads: 873007318 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=AW-873007318"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'AW-873007318');
