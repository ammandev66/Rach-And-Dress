{% render 'wsg-custom' %}
</head>
<body class="template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }}{% if settings.enable_currencies %} currencies-enabled{% endif %}" data-transitions="false"><main class="main-content" id="MainContent">
        {{ content_for_layout }}
      </main></body>
</html>

<script src="https://widget.sezzle.com/v1/javascript/price-widget?uuid=e8ab799c-5e8a-43ae-a078-fd4265dafdce"></script>

