{% comment %}
  Output should match product-grid-item
{% endcomment %}

<style>
  .recently-viewed-image {
    position: relative;
    overflow: hidden;
  }

  .recently-viewed-image img.grid-product__image {
    position: absolute !important;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    object-position: center top;
  }
  /* 900px se neeche: sirf 3 cards */
@media (max-width: 900px) {
  #RecentlyViewed .grid-product,
  .recently-viewed-wrapper .grid-product {
    width: 33.333% !important;
  }

  #RecentlyViewed .grid-product:nth-child(n+4),
  .recently-viewed-wrapper .grid-product:nth-child(n+4) {
    display: none !important;
  }
}

/* 767px se neeche: sirf 2 cards */
@media (max-width: 767px) {
  #RecentlyViewed .grid-product,
  .recently-viewed-wrapper .grid-product {
    width: 50% !important;
  }

  #RecentlyViewed .grid-product:nth-child(n+3),
  .recently-viewed-wrapper .grid-product:nth-child(n+3) {
    display: none !important;
  }
}
</style>

<script id="RecentlyViewedProduct" type="text/template">
{% raw %}
  <hr class="hr--large">
  <div class="index-section index-section--small">
    <div class="page-width">
      <header class="section-header">
        <h3 class="section-header__title">{% endraw %}{{ 'products.general.recent_products' | t }}{% raw %}</h3>
      </header>
    </div>
    <div class="page-width page-width--flush-small">
      <div class="grid-overflow-wrapper">
        <div class="grid grid--uniform" data-aos="overflow__animation">
          {{#items}}
            <div class="grid__item grid-product {{ ../grid_item_width }} aos-animate" data-aos="row-of-5">
              <div class="grid-product__content">
                {{#if sold_out}}
                  <div class="grid-product__tag">
                    {% endraw %}{{ 'products.product.sold_out' | t }}{% raw %}
                  </div>
                {{/if}}
                {{#if on_sale}}
                  {{#unless sold_out}}
                    <div class="grid-product__tag">
                      {% endraw %}{% capture saved_amount %}{% raw %}
                        {{{ money_saved }}}
                      {% endraw %}{% endcapture %}{% raw %}
                      {% endraw %}{{ 'products.general.save_html' | t: saved_amount: saved_amount }}{% raw %}
                    </div>
                  {{/unless}}
                {{/if}}
                <a href="{{ url_formatted }}" class="grid-product__link{{#if sold_out}} grid-product__link--disabled{{/if}}"">
                  <div class="grid-product__image-mask">
                    <!-- CHANGED: fixed 125% ratio (4:5 portrait) instead of {{ image_aspect_ratio }}% -->
                    <div class="image-wrap recently-viewed-image" style="height: 0; padding-bottom: 125%;">
                      <img class="grid-product__image lazyload"
                          data-src="{{ image_responsive_url }}"
                          data-widths="[180, 360, 540, 720, 900]"
                          data-aspectratio="{{ image_aspect_ratio }}"
                          data-sizes="auto"
                          alt="{{ title }}">
                    </div>
                  </div>

                  <div class="grid-product__meta">
                    <div class="grid-product__title grid-product__title--{% endraw %}{{ settings.type_product_style }}{% raw %}">{{ title }}</div>
                    {% endraw %}{% if settings.vendor_enable %}{% raw %}
                      <div class="grid-product__vendor">{{ vendor }}</div>
                    {% endraw %}{% endif %}{% raw %}
                    <div class="grid-product__price">
                      {{#if on_sale}}
                        <span class="visually-hidden">{% endraw %}{{ 'products.general.regular_price' | t }}{% raw %}</span>
                        <span class="grid-product__price--original">{{{ compare_at_price_formatted }}}</span>
                        <span class="visually-hidden">{% endraw %}{{ 'products.general.sale_price' | t }}{% raw %}</span>
                      {{/if}}
                      {{#if price_varies}}
                        {% endraw %}{% capture price_min %}{% raw %}
                          {{{ price_min_formatted }}}
                        {% endraw %}{% endcapture %}{% raw %}
                        {% endraw %}{{ 'products.general.from_text_html' | t: price: price_min }}{% raw %}
                      {{ else }}
                        {{{ price_formatted }}}
                      {{/if}}
                    </div>
                  </div>
                </a>
              </div>
            </div>
          {{/items}}
        </div>
      </div>
    </div>
  </div>
{% endraw %}
</script>